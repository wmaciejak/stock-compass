# Optional local configuration. No market-data key is required.
STOCK_COMPASS_PORT=8765
STOCK_COMPASS_DB=data/compass.sqlite
# Disable external provider access; demo and CSV still work.
STOCK_COMPASS_OFFLINE=0
# Optional AI summaries (restart after editing). Keep the API key backend-only.
OPENAI_API_KEY=
STOCK_COMPASS_AI_ENABLED=0
STOCK_COMPASS_AI_MODEL=gpt-6-luna
STOCK_COMPASS_AI_REASONING=high
STOCK_COMPASS_AI_MAX_OUTPUT_TOKENS=12000
STOCK_COMPASS_AI_TIMEOUT_SECONDS=240
STOCK_COMPASS_AI_MAX_CONTEXT_BYTES=2000000
STOCK_COMPASS_AI_MAX_REQUEST_TOKENS=190000
